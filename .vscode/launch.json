{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Netlify Functions",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["netlify", "dev", "--port", "4225"],
      "env": {
        "NODE_OPTIONS": "--inspect=9229"
      },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
