{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Linux Debug netlify functions",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--inspect-brk"],
      "program": "${workspaceFolder}/node_modules/netlify-cli/bin/run",
      "args": ["dev", "--port", "4225"],
      "autoAttachChildProcesses": true,
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Mac Debug Netlify Functions",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "node --inspect $(which netlify) dev --port 4225"],
      "console": "integratedTerminal"
    }
  ]
}
