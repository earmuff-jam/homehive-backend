{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Netlify Functions",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "netlify",
        "dev",
        "--port",
        "4225"
      ],
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}