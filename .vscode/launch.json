{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Linux Debug Netlify Functions",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "source ~/.nvm/nvm.sh && node --inspect $(which netlify) dev --port 4225"
      ],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Mac Debug Netlify Functions",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "node --inspect $(which netlify) dev --port 4225"],
      "console": "integratedTerminal"
    }
  ]
}
